generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

enum DeviceStatus {
  online
  offline
  isolated
}

enum LogSeverity {
  info
  warning
  error
  critical
}

enum AlertSeverity {
  critical
  high
  medium
  low
}

enum AlertStatus {
  open
  investigating
  resolved
}

enum IncidentStatus {
  open
  investigating
  contained
  resolved
}

enum ThreatType {
  ip
  hash
  domain
}

enum ConnectionStatus {
  normal
  suspicious
}

model Device {
  id           String       @id @default(uuid())
  name         String
  ip           String?
  os           String?
  status       DeviceStatus @default(online)
  lastSeenAt   DateTime?
  processes    Json?

  // Stored hashed so the raw key is never persisted.
  apiKeyHash   String       @unique
  apiKeyPrefix String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  logs          Log[]
  alerts        Alert[]
  networkSamples NetworkSample[]
  connections   NetworkConnection[]
}

model Log {
  id            String      @id @default(uuid())
  deviceId      String
  device        Device      @relation(fields: [deviceId], references: [id], onDelete: Cascade)
  timestamp     DateTime
  eventType     String
  severity      LogSeverity
  message       String
  sourceIp      String?
  destinationIp String?
  rawData       Json
  createdAt     DateTime    @default(now())

  @@index([deviceId, timestamp])
  @@index([severity, timestamp])
}

model Alert {
  id             String       @id @default(uuid())
  deviceId       String?
  device         Device?      @relation(fields: [deviceId], references: [id], onDelete: SetNull)
  timestamp      DateTime
  severity       AlertSeverity
  title          String
  description    String
  status         AlertStatus  @default(open)
  sourceIp       String?
  affectedSystem String?
  attackType     String
  mitreId        String?
  rawLogs        String

  // Optional geo fields to power the attack map.
  country        String?
  lat            Float?
  lng            Float?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status, severity, timestamp])
  @@index([attackType, timestamp])
  @@index([country, timestamp])
}

model Incident {
  id              String         @id @default(uuid())
  title           String
  severity        AlertSeverity
  status          IncidentStatus @default(open)
  assignedTo      String
  createdAt       DateTime
  rootCause       String
  affectedSystems Json
  updatedAt       DateTime       @updatedAt
}

model ThreatItem {
  id          String       @id @default(uuid())
  type        ThreatType
  value       String
  severity    AlertSeverity
  description String
  firstSeen   DateTime
  lastSeen    DateTime
  reputation  Int

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([type, value])
}

model ObservedUser {
  id            String   @id @default(uuid())
  username      String
  email         String?
  role          String?
  lastLogin     DateTime?
  failedAttempts Int     @default(0)
  devices       Json?
  riskScore     Int      @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([username])
}

model NetworkSample {
  id        String   @id @default(uuid())
  deviceId  String?
  device    Device?  @relation(fields: [deviceId], references: [id], onDelete: SetNull)
  timestamp DateTime
  inbound   Int
  outbound  Int
  createdAt DateTime @default(now())

  @@index([timestamp])
}

model NetworkConnection {
  id        String           @id @default(uuid())
  deviceId  String?
  device    Device?          @relation(fields: [deviceId], references: [id], onDelete: SetNull)
  timestamp DateTime
  srcIp     String
  dstIp     String
  port      Int
  protocol  String
  status    ConnectionStatus @default(normal)
  createdAt DateTime         @default(now())

  @@index([timestamp])
  @@index([status, timestamp])
}
